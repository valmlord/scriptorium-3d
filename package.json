{
  "name": "scriptorium-3d",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:shell": "shellcheck $(git ls-files '*.sh' '.husky/*')",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "bench:report": "vitest bench --run --outputJson bench-report.json && vite-node scripts/report-generation-cost.ts bench-report.json",
    "coverage": "vitest run --coverage",
    "test:e2e": "npm run build:e2e && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "golden:regenerate": "vite-node scripts/regenerate-golden-vectors.ts",
    "test:mutation": "stryker run",
    "test:mutation:dry": "bash scripts/check-mutation-harness.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "24.13.3",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.9.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-node": "6.0.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "gsap": "3.15.1",
    "three": "0.187.0"
  }
}
