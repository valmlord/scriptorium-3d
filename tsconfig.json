{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // No baseUrl on purpose: it is deprecated and stops working in TypeScript
    // 7. Without it, every path mapping is resolved relative to this file,
    // which is why each entry is written as an explicit "./" relative path.
    "paths": {
      "@core/*": ["./src/core/*"],
      "@worker/*": ["./src/worker/*"],
      "@engine/*": ["./src/engine/*"],
      "@motion/*": ["./src/motion/*"],
      "@state/*": ["./src/state/*"],
      "@ui/*": ["./src/ui/*"],
      "@app/*": ["./src/app/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
